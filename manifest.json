{
  "manifest_version": 3,
  "name": "Map Jumper",
  "version": "1.2",
  "description": "Extract coordinates from map URLs and open them in different map services",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://maps.google.com/*",
    "*://www.google.com/maps/*",
    "*://maps.ktimatologio.gr/*",
    "*://www.openstreetmap.org/*",
    "*://www.bing.com/maps/*",
    "*://www.mapillary.com/*",
    "*://wikishootme.toolforge.org/*",
    "*://osmand.net/*"
  ],
  "action": {
    "default_popup": "",
    "default_title": "Maps Jumper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://maps.google.com/*",
        "*://www.google.com/maps/*",
        "*://maps.ktimatologio.gr/*",
        "*://www.openstreetmap.org/*",
        "*://www.bing.com/maps/*",
        "*://www.mapillary.com/*",
        "*://wikishootme.toolforge.org/*",
        "*://osmand.net/*"
      ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}